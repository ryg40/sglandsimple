# Copy to .env.local and fill in. Both .env.local and .env are gitignored.
# Compose loads this via the `env_file:` directive on each service.

# ---- Upstream OpenAI-compatible LLM (REQUIRED) -----------------------------
UPSTREAM_BASE_URL=http://your-llm-host:8001/v1
UPSTREAM_API_KEY=dummy
UPSTREAM_MODEL=your-model-id

# ---- SearXNG (REQUIRED for web_research) -----------------------------------
SEARXNG_URL=http://your-searxng-host:8888

# ---- Public hostname (Caddy on the external `proxy` network) ---------------
PUBLIC_HOSTNAME=your-host.example.com

# ---- Host ports ------------------------------------------------------------
AGENT_PORT=5450
MCP_PORT=5451

# ---- Stage 1 (Mongo + LangGraph) -- TBD ------------------------------------
MONGO_URL=mongodb://app:app@mongo:27017/enterprise?authSource=admin
MONGO_DB=enterprise
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=rootpw
ASK_DATA_MAX_DOCS=4
ASK_DATA_LIMIT_CEILING=50
LANGGRAPH_CHECKPOINT_COLLECTION=lg_checkpoints

# ---- Stage 2 (Web frontend) ------------------------------------------------
WEB_PORT=5452

# ---- Stage 3 (MCP hardening) -----------------------------------------------
MCP_AUTH_TOKEN=
MCP_RATE_PER_MIN=60

# ---- Stage 4 (Deep-agent planner/builder) ----------------------------------
# Per-role LLM overrides. If unset, the role falls back to UPSTREAM_*.
# PLANNER is the current Qwen on UPSTREAM_BASE_URL — leave unset to inherit.
PLANNER_BASE_URL=
PLANNER_MODEL=
PLANNER_API_KEY=
# BUILDER is a separate model used for code/web/research execution.
BUILDER_BASE_URL=http://192.168.29.129:9292/v1
BUILDER_MODEL=Qwen3.6-35B-Apex-Bal
BUILDER_API_KEY=dummy
# Per-LLM-call token budget. Prompt > budget triggers a summarization pass.
DEEP_AGENT_BUDGET_PER_CALL=70000
# Hard caps for a single run_plan invocation.
DEEP_AGENT_MAX_STEPS=25
DEEP_AGENT_MAX_SECONDS=600

# ---- Stage 6 (Spreadsheet UI + NL data editing) ----------------------------
# Master switch for all write tools (sheet_* + sheet_apply_nl). Set to
# `false` to make every write helper fail closed without touching Mongo.
SHEET_WRITES_ENABLED=true
# Collection that stores the audit trail for sheet/NL writes.
SHEET_AUDIT_COLLECTION=audit_log
# Hard cap on the number of ops a single sheet_apply_nl call may apply.
SHEET_APPLY_MAX_OPS=50

# ---- Stage 7 (Reactive aggregation builder) --------------------------------
# Rows pulled for the initial light sample on collection load.
WRANGLER_SAMPLE_LIMIT=50
# Rows returned by each per-stage wrangler_run_prefix preview.
WRANGLER_PREVIEW_LIMIT=25
# Hard cap on the number of stages a single pipeline may contain.
WRANGLER_MAX_STAGES=12
