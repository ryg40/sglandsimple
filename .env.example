# Copy to .env.local and fill in. Both .env.local and .env are gitignored.
# Compose loads this via the `env_file:` directive on each service.

# ---- Upstream OpenAI-compatible LLM (REQUIRED) -----------------------------
UPSTREAM_BASE_URL=http://your-llm-host:8001/v1
UPSTREAM_API_KEY=dummy
UPSTREAM_MODEL=your-model-id
# Default max_tokens forwarded to upstream when client omits it (0 = no default).
UPSTREAM_MAX_TOKENS=0

# ---- SearXNG (REQUIRED for web_research) -----------------------------------
SEARXNG_URL=http://your-searxng-host:8888

# ---- Public hostname (Caddy on the external `proxy` network) ---------------
PUBLIC_HOSTNAME=your-host.example.com

# ---- Host ports ------------------------------------------------------------
AGENT_PORT=5450
MCP_PORT=5451

# ---- Stage 1 (Mongo + LangGraph) -- TBD ------------------------------------
MONGO_URL=mongodb://app:app@mongo:27017/enterprise?authSource=admin
MONGO_DB=enterprise
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=rootpw
ASK_DATA_MAX_DOCS=4
ASK_DATA_DEADLINE_SECONDS=240
ASK_DATA_BATCH_NOTES=true
ASK_DATA_LIMIT_CEILING=50
LANGGRAPH_CHECKPOINT_COLLECTION=lg_checkpoints

# ---- Stage 2 (Web frontend) ------------------------------------------------
WEB_PORT=5452
REQUEST_TIMEOUT=300

# ---- Stage 3 (MCP hardening) -----------------------------------------------
MCP_AUTH_TOKEN=
MCP_RATE_PER_MIN=60

# ---- Stage 4 (Deep-agent planner/builder) ----------------------------------
# Per-role LLM overrides. If unset, the role falls back to UPSTREAM_*.
# PLANNER is the current Qwen on UPSTREAM_BASE_URL — leave unset to inherit.
PLANNER_BASE_URL=
PLANNER_MODEL=
PLANNER_API_KEY=
# BUILDER is a separate model used for code/web/research execution.
BUILDER_BASE_URL=http://192.168.29.129:9292/v1
BUILDER_MODEL=Qwen3.6-35B-A3B-APEX-MTP-I-Balanced
BUILDER_API_KEY=dummy
BUILDER_MAX_TOKENS=60000
# Per-LLM-call token budget. Prompt > budget triggers a summarization pass.
DEEP_AGENT_BUDGET_PER_CALL=70000
# Hard caps for a single run_plan invocation.
DEEP_AGENT_MAX_STEPS=25
DEEP_AGENT_MAX_SECONDS=600

# ---- Stage 21 (Deep Agent platform) ----------------------------------------
# Where the deep-agent runtime executes. `in_mcp` (default) runs it inside the
# mcp container. `sidecar` uses the optional `sandbox` service — start it with
# `docker compose --profile sandbox up -d`. `remote` targets ECS/Fargate/K8s.
DEEP_AGENT_RUNTIME_MODE=in_mcp
# Path to the agent profile/tool-scope config (one agent per system).
DEEP_AGENT_PROFILES_FILE=/app/deep_agent/profiles.yaml
# Directory (under the shared /sandbox mount) for agent-generated artifacts.
DEEP_AGENT_ARTIFACT_DIR=/sandbox/agent-artifacts
# POC guardrail: never apply live external writes regardless of connector gates.
DEEP_AGENT_DRY_RUN_ONLY=true
# Mongo collections for run records + the policy/approval audit trail (S21).
DEEP_AGENT_RUN_COLLECTION=deep_agent_runs
DEEP_AGENT_AUDIT_COLLECTION=deep_agent_audit

# ---- Stage 21 — Bedrock provider adapter (S21.bedrock.1, optional) ----------
# Any LLM role (UPSTREAM/PLANNER/BUILDER) can target Amazon Bedrock instead of
# an OpenAI-compatible endpoint by setting <PREFIX>_PROVIDER=bedrock. Requires
# the optional deps `langchain-aws boto3` (not installed by default) and AWS
# credentials via the standard chain (IAM task/instance role or AWS_* env) —
# Bedrock does NOT use an API key. The task/pod role needs bedrock:InvokeModel
# (+ ...WithResponseStream) on the target model ARNs. Leave PROVIDER unset to
# keep the unchanged OpenAI-compatible path.
# BUILDER_PROVIDER=bedrock
# BUILDER_BEDROCK_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
# BUILDER_BEDROCK_REGION=us-east-1
# AWS_REGION=us-east-1   # fallback region for any bedrock role

# ---- Stage 6 (Spreadsheet UI + NL data editing) ----------------------------
# Master switch for all write tools (sheet_* + sheet_apply_nl). Set to
# `false` to make every write helper fail closed without touching Mongo.
SHEET_WRITES_ENABLED=true
# Collection that stores the audit trail for sheet/NL writes.
SHEET_AUDIT_COLLECTION=audit_log
# Hard cap on the number of ops a single sheet_apply_nl call may apply.
SHEET_APPLY_MAX_OPS=50

# ---- Stage 7 (Reactive aggregation builder) --------------------------------
# Rows pulled for the initial light sample on collection load.
WRANGLER_SAMPLE_LIMIT=50
# Rows returned by each per-stage wrangler_run_prefix preview.
WRANGLER_PREVIEW_LIMIT=25
# Hard cap on the number of stages a single pipeline may contain.
WRANGLER_MAX_STAGES=12

# ---- Stage 8 (React + shadcn/ui admin panel) -------------------------------
# vite build mode; set to `development` for source maps.
WEB_BUILD_MODE=production
# Default rows for the Overview "recent activity" table.
AUDIT_RECENT_LIMIT=25

# ---- Stage 11 (Compliance command center) ----------------------------------
# Window (days) for the "due soon" attention rule.
OVERVIEW_DUE_SOON_DAYS=14
# No-update window (days) before an open work-item/PR counts as "stalled".
OVERVIEW_STALE_DAYS=7
# Max rows in the attention (points-of-concern) panel.
OVERVIEW_ATTENTION_LIMIT=10
# Rows shown per mini-table in the multi-table region.
OVERVIEW_TABLE_ROWS=5
# Front-end poll cadence (ms) for /api/overview.
OVERVIEW_POLL_MS=30000

# ---- Stage 9 (Compliance workflow hub) -------------------------------------
# Master gate for live mutations across all connectors. When false, the
# workflow runs in dry-run and connectors stay in mock mode unless their
# own enable flag is set. Default OFF — no outbound writes.
WORKFLOW_WRITES_ENABLED=false
# Where generated PDF/PPT reports are written (inside the sandbox mount).
REPORT_OUTPUT_DIR=/sandbox/reports

# Per-connector enable flags (default off => bubble shows mock/not-connected
# and the connector's tools refuse with a clear message; no outbound calls).
# Atlassian Jira (MCP)
CONN_JIRA_ENABLED=false
JIRA_MCP_URL=
JIRA_MCP_TOKEN=
# Stage 16 — HIL-gated Jira bulk edits. Staged edits never reach Jira until
# applied; apply only mutates the live API when JIRA_WRITES_ENABLED=true,
# otherwise it produces an auditable dry-run plan.
JIRA_WRITES_ENABLED=false
JIRA_STAGE_MAX_EDITS=100
# Atlassian Confluence (MCP)
CONN_CONFLUENCE_ENABLED=false
CONFLUENCE_MCP_URL=
# Stage 23 primary credential name; falls back to CONFLUENCE_MCP_TOKEN if unset.
CONFLUENCE_TOKEN=
CONFLUENCE_MCP_TOKEN=
# Live page create/update also requires WORKFLOW_WRITES_ENABLED=true.
CONFLUENCE_WRITES_ENABLED=false
# GitHub (MCP)
CONN_GITHUB_ENABLED=false
GITHUB_MCP_URL=
GITHUB_MCP_TOKEN=
# AWS (MCP) — RDS inventory + log-config evidence
CONN_AWS_ENABLED=false
AWS_MCP_URL=
# Datadog observability (read-only mock connector; S21.extend.1 reference agent)
CONN_DATADOG_ENABLED=false
DATADOG_MCP_URL=
DATADOG_MCP_TOKEN=
# ServiceNow (REST API)
CONN_SERVICENOW_ENABLED=false
SERVICENOW_BASE_URL=
SERVICENOW_TOKEN=
# Snowflake (SQL via tool_calls) — cloud audit-log warehouse
CONN_SNOWFLAKE_ENABLED=false
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_TOKEN=
# Archer RIMS — placeholder until a real API is provisioned (mock data when off)
CONN_ARCHER_ENABLED=false

# ---- Stage 14 (Docs Wiki + Confluence sync) -------------------------------
DOCS_REVIEW_DAYS=90          # age (days) after which a doc auto-flags needs_attention
DOCS_CONFLUENCE_SPACE=COMP   # Confluence space key public docs sync into
DOCS_SYNC_ENABLED=false      # master gate for Confluence push (also needs CONN_CONFLUENCE_ENABLED + WORKFLOW_WRITES_ENABLED)
DOCS_DEFAULT_VISIBILITY=internal

# --- Stage 19: Web auth / RBAC ---
# Auth mode: sso | basic | trusted_network | headers | ldap | disabled
AUTH_MODE=basic
# LDAP group names (config values; swap for real LDAP groups without code changes)
AUTH_ALL_USERS_GROUP=sg_all_users           # grants viewer role
AUTH_ADMIN_GROUP=sg_sec_admin               # grants admin role
AUTH_APP_USER_GROUP=sg_app_user             # grants app_user role
AUTH_AUDIT_USER_GROUP=sg_audit_users        # grants audit_user role
# Trusted proxy / SSO headers (used in sso and trusted_network modes)
AUTH_TRUSTED_HEADER_USER=X-Forwarded-User
AUTH_TRUSTED_HEADER_GROUPS=X-Forwarded-Groups
# Production guardrail: when true the app refuses to start unless AUTH_MODE=sso
AUTH_SSO_REQUIRED=false
# Basic Auth: seeded users/hashes file (created by S19.seed.1; never committed)
AUTH_BASIC_USERS_FILE=/data/auth/users.json
# Dev-only seed password for generated POC users; use a gitignored secret file in CI
AUTH_BASIC_SEED_PASSWORD=
# Dev/test header mode; MUST be false in production
AUTH_DEV_HEADERS_ENABLED=false
# Future LDAP adapter (S19.ldap.1)
AUTH_LDAP_URL=
AUTH_LDAP_BASE_DN=
AUTH_LDAP_BIND_SECRET_FILE=                 # path to mounted secret; never inline
# Cache TTL for group lookup results (seconds)
AUTH_CACHE_TTL_SECONDS=300

# ---- Stage 20 (Standup Jira cockpit) --------------------------------------
STANDUP_WS_ENABLED=true
STANDUP_SESSION_TTL_HOURS=24
STANDUP_MAX_MESSAGES=500
STANDUP_AGENT_ENABLED=true
STANDUP_AGENT_INTERVAL_SECONDS=0
STANDUP_REQUIRE_ADMIN=true
STANDUP_APPROVER_EMAILS=simone.patel@lanGarland.com
STANDUP_DRY_RUN_ONLY=true

# ---- Stage 24 (Standup reference rail) ------------------------------------
STANDUP_EPICS_ACTIVE_ONLY=true
STANDUP_EPICS_LIMIT=25
STANDUP_TEMPLATES_ENABLED=true
# Optional demo intake rows when Jira has no unassigned/new incoming tickets.
STANDUP_INCOMING_DEMO=false

# ---- Stage 32 (LDAP directory enrichment, fixture mode by default) --------
LDAP_ENABLED=false
CONN_LDAP_ENABLED=false
LDAP_MODE=fixture
LDAP_APP_ID=sglandsimple-directory-poc
LDAP_BIND_DN=CN=sglandsimple-directory-poc,OU=Service Accounts,DC=lanGarland,DC=com
LDAP_BASE_DN=DC=lanGarland,DC=com
LDAP_SERVER_URI=
LDAP_USERS_FILE=/app/fixtures/ldap_users.json
