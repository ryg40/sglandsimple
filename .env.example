# Copy to .env.local and fill in. Both .env.local and .env are gitignored.
# Compose loads this via the `env_file:` directive on each service.

# ---- Upstream OpenAI-compatible LLM (REQUIRED) -----------------------------
UPSTREAM_BASE_URL=http://your-llm-host:8001/v1
UPSTREAM_API_KEY=dummy
UPSTREAM_MODEL=your-model-id
# Default max_tokens forwarded to upstream when client omits it (0 = no default).
UPSTREAM_MAX_TOKENS=0

# ---- SearXNG (REQUIRED for web_research) -----------------------------------
SEARXNG_URL=http://your-searxng-host:8888

# ---- Public hostname (Caddy on the external `proxy` network) ---------------
PUBLIC_HOSTNAME=your-host.example.com

# ---- Host ports ------------------------------------------------------------
AGENT_PORT=5450
MCP_PORT=5451

# ---- Stage 1 (Mongo + LangGraph) -- TBD ------------------------------------
MONGO_URL=mongodb://app:app@mongo:27017/enterprise?authSource=admin
MONGO_DB=enterprise
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=rootpw
ASK_DATA_MAX_DOCS=4
ASK_DATA_LIMIT_CEILING=50
LANGGRAPH_CHECKPOINT_COLLECTION=lg_checkpoints

# ---- Stage 2 (Web frontend) ------------------------------------------------
WEB_PORT=5452

# ---- Stage 3 (MCP hardening) -----------------------------------------------
MCP_AUTH_TOKEN=
MCP_RATE_PER_MIN=60

# ---- Stage 4 (Deep-agent planner/builder) ----------------------------------
# Per-role LLM overrides. If unset, the role falls back to UPSTREAM_*.
# PLANNER is the current Qwen on UPSTREAM_BASE_URL — leave unset to inherit.
PLANNER_BASE_URL=
PLANNER_MODEL=
PLANNER_API_KEY=
# BUILDER is a separate model used for code/web/research execution.
BUILDER_BASE_URL=http://192.168.29.129:9292/v1
BUILDER_MODEL=Qwen3.6-35B-A3B-APEX-MTP-I-Balanced
BUILDER_API_KEY=dummy
BUILDER_MAX_TOKENS=60000
# Per-LLM-call token budget. Prompt > budget triggers a summarization pass.
DEEP_AGENT_BUDGET_PER_CALL=70000
# Hard caps for a single run_plan invocation.
DEEP_AGENT_MAX_STEPS=25
DEEP_AGENT_MAX_SECONDS=600

# ---- Stage 6 (Spreadsheet UI + NL data editing) ----------------------------
# Master switch for all write tools (sheet_* + sheet_apply_nl). Set to
# `false` to make every write helper fail closed without touching Mongo.
SHEET_WRITES_ENABLED=true
# Collection that stores the audit trail for sheet/NL writes.
SHEET_AUDIT_COLLECTION=audit_log
# Hard cap on the number of ops a single sheet_apply_nl call may apply.
SHEET_APPLY_MAX_OPS=50

# ---- Stage 7 (Reactive aggregation builder) --------------------------------
# Rows pulled for the initial light sample on collection load.
WRANGLER_SAMPLE_LIMIT=50
# Rows returned by each per-stage wrangler_run_prefix preview.
WRANGLER_PREVIEW_LIMIT=25
# Hard cap on the number of stages a single pipeline may contain.
WRANGLER_MAX_STAGES=12

# ---- Stage 8 (React + shadcn/ui admin panel) -------------------------------
# vite build mode; set to `development` for source maps.
WEB_BUILD_MODE=production
# Default rows for the Overview "recent activity" table.
AUDIT_RECENT_LIMIT=25

# ---- Stage 11 (Compliance command center) ----------------------------------
# Window (days) for the "due soon" attention rule.
OVERVIEW_DUE_SOON_DAYS=14
# No-update window (days) before an open work-item/PR counts as "stalled".
OVERVIEW_STALE_DAYS=7
# Max rows in the attention (points-of-concern) panel.
OVERVIEW_ATTENTION_LIMIT=10
# Rows shown per mini-table in the multi-table region.
OVERVIEW_TABLE_ROWS=5
# Front-end poll cadence (ms) for /api/overview.
OVERVIEW_POLL_MS=30000

# ---- Stage 9 (Compliance workflow hub) -------------------------------------
# Master gate for live mutations across all connectors. When false, the
# workflow runs in dry-run and connectors stay in mock mode unless their
# own enable flag is set. Default OFF — no outbound writes.
WORKFLOW_WRITES_ENABLED=false
# Where generated PDF/PPT reports are written (inside the sandbox mount).
REPORT_OUTPUT_DIR=/sandbox/reports

# Per-connector enable flags (default off => bubble shows mock/not-connected
# and the connector's tools refuse with a clear message; no outbound calls).
# Atlassian Jira (MCP)
CONN_JIRA_ENABLED=false
JIRA_MCP_URL=
JIRA_MCP_TOKEN=
# Stage 16 — HIL-gated Jira bulk edits. Staged edits never reach Jira until
# applied; apply only mutates the live API when JIRA_WRITES_ENABLED=true,
# otherwise it produces an auditable dry-run plan.
JIRA_WRITES_ENABLED=false
JIRA_STAGE_MAX_EDITS=100
# Atlassian Confluence (MCP)
CONN_CONFLUENCE_ENABLED=false
CONFLUENCE_MCP_URL=
CONFLUENCE_MCP_TOKEN=
# GitHub (MCP)
CONN_GITHUB_ENABLED=false
GITHUB_MCP_URL=
GITHUB_MCP_TOKEN=
# AWS (MCP) — RDS inventory + log-config evidence
CONN_AWS_ENABLED=false
AWS_MCP_URL=
# ServiceNow (REST API)
CONN_SERVICENOW_ENABLED=false
SERVICENOW_BASE_URL=
SERVICENOW_TOKEN=
# Snowflake (SQL via tool_calls) — cloud audit-log warehouse
CONN_SNOWFLAKE_ENABLED=false
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_TOKEN=
# Archer RIMS — placeholder until a real API is provisioned (mock data when off)
CONN_ARCHER_ENABLED=false
